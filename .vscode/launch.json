{
  "version": "0.2.0",
  "configurations": [
    {
      // F5 直接跑当前打开的文件，断点可用
      "name": "Python: 当前文件",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    {
      // 跑 CLI 统计：等价于 python -m config_forge.cli --schema config/schema.yaml --data data
      "name": "运行 CLI（schema + data）",
      "type": "debugpy",
      "request": "launch",
      "module": "config_forge.cli",
      "args": ["--schema", "config/schema.yaml", "--data", "data"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    {
      // 跑全部测试，可打断点
      "name": "Pytest: 全部测试",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONIOENCODING": "utf-8" }
    }
  ]
}
